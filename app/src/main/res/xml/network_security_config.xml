<?xml version="1.0" encoding="utf-8"?>
<!--
  Printers on a home or office network speak IPP over plain HTTP (port 631) at addresses that change
  (192.168.x.x, 10.x.x.x, printer.local). Android blocks plain HTTP by default for apps targeting
  API 28+, which silently broke every IPP job. Allow it; secure IPPS still uses TLS with pinning.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
